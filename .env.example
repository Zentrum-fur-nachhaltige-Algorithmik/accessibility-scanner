# Server
PORT=3000
# Bearer token required for /api/* and /reports/* when set
API_TOKEN=
# Comma-separated host allowlist for scan targets (empty: any public host)
SCAN_ALLOWED_HOSTS=
SCAN_CONCURRENCY=1
SCAN_RATE_LIMIT_MAX=5
SCAN_RATE_LIMIT_WINDOW_MS=3600000
# error | warn | info | debug
LOG_LEVEL=info
# Scanner screenshots (default: <os tmpdir>/accessibility-scanner/screenshots)
SCREENSHOT_DIR=
# Organisation name printed on reports
REPORT_ORG_NAME=Accessibility Scanner

# LLM scanners (registered only when the key is set)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.5-flash
LLM_FALLBACK_MODELS=google/gemini-3-flash-preview

# Frontend (build time): origin of the API the Next.js app proxies to
API_ORIGIN=http://localhost:3000
# Docker compose host ports
HOST_PORT=3000
FRONTEND_HOST_PORT=3001
