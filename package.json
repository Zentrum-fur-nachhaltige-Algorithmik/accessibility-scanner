{
  "name": "accessibility-scanner",
  "version": "1.0.0",
  "description": "WCAG 2.2 scanner: axe-core, deterministic Puppeteer checks and optional LLM review behind an Express API and a Next.js UI",
  "private": true,
  "main": "src/server.js",
  "author": "Aaron Berman",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "frontend:dev": "next dev frontend",
    "frontend:build": "next build frontend",
    "frontend:start": "next start frontend",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:agent": "vitest run --project agent",
    "test:self-scan": "vitest run --project self-scan",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "coverage-matrix": "node scripts/coverage-matrix.js",
    "coverage-matrix:check": "node scripts/coverage-matrix.js --check",
    "trust:derive": "node scripts/derive-scanner-trust.js",
    "trust:check": "node scripts/derive-scanner-trust.js --check",
    "harness:exclusive": "node scripts/harness/exclusive.js",
    "harness:concurrent": "node scripts/harness/concurrent.js",
    "harness:llm": "node scripts/harness/llm.js",
    "harness:golden": "node scripts/harness/golden.js",
    "harness:realworld": "node scripts/harness/realworld.js",
    "sr-agent": "node src/agent/run.js",
    "blind-mode": "node src/agent/blind-mode/server/index.js",
    "lint": "eslint . && sh scripts/check-no-emdash.sh",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.11.1",
    "axe-core": "^4.10.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fs-extra": "^11.3.0",
    "helmet": "^8.1.0",
    "next": "^15.3.5",
    "p-queue": "^9.1.0",
    "puppeteer": "^22.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vitest": "^4.0.18"
  }
}
