{
  "name": "Comprehensive Website Accessibility Test Suite",
  "description": "Complete WCAG 2.1 AA compliance testing with failed test isolation",
  "version": "1.0.0",
  "author": "Enhanced E2E Testing System",
  "created": "2024-01-01T00:00:00.000Z",
  "tests": [
    {
      "type": "single",
      "name": "Homepage Accessibility Audit",
      "description": "Comprehensive accessibility testing of the main homepage",
      "url": "https://example.com",
      "config": {
        "maxViolations": 0,
        "requiredElements": ["lang", "title", "alt-texts", "form-labels"],
        "keyboardNavigation": true,
        "colorContrast": "AA",
        "performanceThreshold": 3000,
        "mobileResponsive": true,
        "htmlValidation": true,
        "screenReaderCompatibility": true
      }
    },
    {
      "type": "single",
      "name": "Color Contrast Deep Analysis",
      "description": "Detailed color contrast testing for WCAG AA compliance",
      "url": "https://example.com",
      "config": {
        "maxViolations": 0,
        "colorContrast": "AA",
        "customTests": {
          "colorContrastAnalysis": true,
          "screenReaderCompatibility": true
        },
        "screenshots": {
          "captureViewports": ["desktop", "tablet", "mobile"],
          "captureInteractiveStates": true
        }
      }
    },
    {
      "type": "single",
      "name": "Keyboard Navigation Test",
      "description": "Comprehensive keyboard accessibility testing",
      "url": "https://example.com",
      "config": {
        "keyboardNavigation": true,
        "maxViolations": 2,
        "customTests": {
          "keyboardNavigation": true,
          "focusManagement": true
        }
      }
    },
    {
      "type": "batch",
      "name": "Multi-Page Consistency Check",
      "description": "Test multiple pages for consistent accessibility implementation",
      "urls": [
        "https://example.com",
        "https://example.com/about",
        "https://example.com/contact",
        "https://example.com/products",
        "https://example.com/services"
      ],
      "config": {
        "maxConcurrent": 2,
        "retryAttempts": 3,
        "maxViolations": 5,
        "performanceThreshold": 4000,
        "htmlValidation": true,
        "customTests": {
          "screenReaderCompatibility": true,
          "responsiveDesign": true
        }
      }
    },
    {
      "type": "single",
      "name": "Mobile Responsiveness Test",
      "description": "Detailed mobile and tablet responsiveness testing",
      "url": "https://example.com",
      "config": {
        "mobileResponsive": true,
        "screenshots": {
          "enabled": true,
          "captureViewports": ["mobile", "tablet", "desktop"],
          "captureFullPage": true,
          "quality": 90
        },
        "customTests": {
          "responsiveDesign": true
        }
      }
    },
    {
      "type": "batch",
      "name": "Form Accessibility Testing",
      "description": "Test all forms for accessibility compliance",
      "urls": [
        "https://example.com/contact",
        "https://example.com/signup",
        "https://example.com/login",
        "https://example.com/newsletter"
      ],
      "config": {
        "maxConcurrent": 2,
        "maxViolations": 0,
        "requiredElements": ["form-labels", "alt-texts"],
        "keyboardNavigation": true,
        "customTests": {
          "formValidation": true,
          "keyboardNavigation": true,
          "screenReaderCompatibility": true
        }
      }
    },
    {
      "type": "single",
      "name": "Performance Impact Assessment",
      "description": "Test how accessibility features impact performance",
      "url": "https://example.com",
      "config": {
        "performanceThreshold": 2000,
        "maxViolations": 10,
        "screenshots": {
          "enabled": true,
          "captureViewports": ["desktop"]
        },
        "performance": {
          "trackMemoryUsage": true,
          "trackExecutionTime": true,
          "enableProfiling": true
        }
      }
    },
    {
      "type": "batch",
      "name": "E-commerce Accessibility Suite",
      "description": "Specialized testing for e-commerce functionality",
      "urls": [
        "https://example-shop.com",
        "https://example-shop.com/products",
        "https://example-shop.com/cart",
        "https://example-shop.com/checkout"
      ],
      "config": {
        "maxConcurrent": 2,
        "maxViolations": 3,
        "colorContrast": "AA",
        "keyboardNavigation": true,
        "customTests": {
          "screenReaderCompatibility": true,
          "keyboardNavigation": true,
          "formValidation": true
        },
        "failedTestIsolation": {
          "enabled": true,
          "isolateOnFirstFailure": true,
          "categorizeFailures": true
        }
      }
    },
    {
      "type": "single",
      "name": "Screen Reader Compatibility Deep Test",
      "description": "Comprehensive screen reader accessibility testing",
      "url": "https://example.com",
      "config": {
        "maxViolations": 0,
        "requiredElements": ["lang", "title", "alt-texts", "aria-labels"],
        "customTests": {
          "screenReaderCompatibility": true,
          "ariaImplementation": true,
          "landmarkRoles": true,
          "headingStructure": true
        },
        "accessibility": {
          "axeRules": {
            "aria-labels": { "enabled": true },
            "heading-order": { "enabled": true },
            "landmark-roles": { "enabled": true },
            "aria-valid-attr": { "enabled": true },
            "aria-required-attr": { "enabled": true }
          }
        }
      }
    },
    {
      "type": "batch",
      "name": "Multi-Language Accessibility",
      "description": "Test accessibility across different language versions",
      "urls": [
        "https://example.com/en",
        "https://example.com/de",
        "https://example.com/fr",
        "https://example.com/es"
      ],
      "config": {
        "maxConcurrent": 2,
        "maxViolations": 5,
        "requiredElements": ["lang"],
        "htmlValidation": true,
        "customTests": {
          "languageDetection": true,
          "screenReaderCompatibility": true
        }
      }
    }
  ],
  "globalConfig": {
    "browser": {
      "headless": true,
      "viewport": { "width": 1920, "height": 1080 },
      "timeout": 30000
    },
    "screenshots": {
      "enabled": true,
      "captureFullPage": true,
      "quality": 80,
      "captureOnFailure": true
    },
    "reporting": {
      "formats": ["json", "html", "csv"],
      "includeScreenshots": true,
      "includeDebugInfo": true,
      "generateSummary": true,
      "includeFailureAnalysis": true,
      "realTimeUpdates": true
    },
    "failedTestIsolation": {
      "enabled": true,
      "isolateOnFirstFailure": true,
      "preserveScreenshots": true,
      "preserveHtmlSnapshot": true,
      "generateRetryInstructions": true,
      "categorizeFailures": true
    },
    "batch": {
      "maxConcurrent": 3,
      "retryAttempts": 3,
      "retryDelay": 1000,
      "retryBackoff": 2,
      "circuitBreakerThreshold": 5,
      "circuitBreakerTimeout": 30000,
      "timeoutPerTest": 60000,
      "enablePersistence": true
    },
    "logging": {
      "level": "info",
      "enableFileLogging": true,
      "enableConsoleLogging": true,
      "logToSeparateFiles": true
    }
  },
  "expectedResults": {
    "totalTests": 10,
    "minimumPassRate": 80,
    "maxAcceptableViolations": 20,
    "maxDurationMinutes": 30
  },
  "metadata": {
    "tags": ["accessibility", "wcag", "e2e", "comprehensive"],
    "priority": "high",
    "frequency": "daily",
    "owner": "accessibility-team",
    "notifications": {
      "onFailure": true,
      "onCompletion": true,
      "email": "accessibility-team@company.com"
    }
  }
}