{
  "name": "web-accessibility-checker",
  "version": "1.0.0",
  "description": "Web accessibility checker with focus on screen reader support and EU compliance",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node src/test.js",
    "test:phase2": "node src/phase2-test.js",
    "test:phase3": "node src/phase3-test.js",
    "test:phase4": "node src/phase4-test.js",
    "test:phase6a": "node src/phase6a-test.js",
    "api:start": "node src/api-server.js",
    "frontend:dev": "next dev frontend",
    "frontend:build": "next build frontend",
    "frontend:start": "next start frontend",
    "e2e": "node src/enhanced-e2e-cli.js",
    "e2e:single": "node src/enhanced-e2e-cli.js single",
    "e2e:batch": "node src/enhanced-e2e-cli.js batch",
    "e2e:suite": "node src/enhanced-e2e-cli.js suite",
    "e2e:config": "node src/enhanced-e2e-cli.js config",
    "e2e:status": "node src/enhanced-e2e-cli.js status",
    "e2e:example": "node examples/example-usage.js",
    "e2e:demo": "node src/enhanced-e2e-cli.js suite --suite=config/example-test-suite.json"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "eu-compliance",
    "screen-reader"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axe-core": "^4.10.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fs-extra": "^11.3.0",
    "helmet": "^8.1.0",
    "html-pdf-node": "^1.0.8",
    "next": "^15.3.5",
    "pa11y": "^9.0.0",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "puppeteer": "^22.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^5.6.0",
    "uuid": "^11.1.0"
  }
}
